# ApnaCity environment template — copy to .env and fill values.
# ALL values are Zod-validated at boot; missing/invalid ⇒ app refuses to start.
# NEVER commit real .env files (gitignored).

# core
NODE_ENV=development
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
APP_DOMAIN=apnacity.com
TENANT_RESOLVE_HMAC_SECRET=change-me

# database
DATABASE_URL=postgresql://apnacity:apnacity@localhost:5432/apnacity
DB_POOL_MAX=20

# redis
REDIS_URL=redis://localhost:6379

# ============================================================================
# MEDIA / STORAGE (M10)
# ----------------------------------------------------------------------------
# MEDIA_STORAGE_DRIVER selects the backend:
#   disk → files on a local/mounted volume. DEV DEFAULT. No S3/MinIO needed.
#   s3   → S3-compatible object store (AWS S3 / Cloudflare R2 / MinIO).
#          When set to "s3", the S3_* values below are REQUIRED (the app refuses
#          to boot otherwise). This is the single flag to flip for production.
MEDIA_STORAGE_DRIVER=disk

# --- disk driver (used when MEDIA_STORAGE_DRIVER=disk) ---
# In the cluster, point MEDIA_DISK_ROOT at a mounted PVC path (persistent).
MEDIA_DISK_ROOT=./.media-data
MEDIA_PUBLIC_BASE_URL=http://localhost:4000/v1/media/file
MEDIA_SIGNED_URL_TTL=600            # seconds; signed private-URL lifetime (both drivers)
MEDIA_SIGN_SECRET=change-me-dev     # HMAC secret for signed private disk URLs (prod: strong random)

# --- s3 driver (FILL THESE FOR PRODUCTION — required when DRIVER=s3) ---
# AWS S3:        S3_ENDPOINT blank/omit, S3_FORCE_PATH_STYLE=false, set S3_REGION.
# Cloudflare R2: S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com,
#                S3_REGION=auto, S3_FORCE_PATH_STYLE=true.
# MinIO:         S3_ENDPOINT=http://minio.apnacity.svc:9000 (or NodePort),
#                S3_FORCE_PATH_STYLE=true.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_PUBLIC=apnacity-media     # product images, logos, banners (public-read / CDN)
S3_BUCKET_PRIVATE=apnacity-docs     # KYC docs, PoD, return photos (signed URLs only)
S3_ACCESS_KEY_ID=                   # PROD: fill (AWS IAM key / R2 token / MinIO user)
S3_SECRET_ACCESS_KEY=               # PROD: fill (keep out of git; use a secret manager)
S3_FORCE_PATH_STYLE=true            # true for MinIO/R2, false for AWS S3
CDN_BASE_URL=                       # PROD: public CDN origin for public bucket (e.g. https://cdn.apnacity.com)

# auth
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL=900
REFRESH_SECRET=change-me
OTP_HASH_PEPPER=change-me

# payments
PAYMENT_PROVIDER=cashfree
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=

# notifications
DLT_SMS_PROVIDER=
DLT_SENDER_ID=
DLT_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_KEY=
EMAIL_FROM=
SMTP_URL=

# maps
GEO_PROVIDER=google
GOOGLE_MAPS_KEY=

# misc
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
FEATURE_FLAG_DEFAULTS={}
