# ApnaCity environment template — copy to .env and fill values.
# ALL values are Zod-validated at boot; missing/invalid ⇒ app refuses to start.
# NEVER commit real .env files (gitignored).

# core
NODE_ENV=development
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
APP_DOMAIN=apnacity.com
TENANT_RESOLVE_HMAC_SECRET=change-me

# database
DATABASE_URL=postgresql://apnacity:apnacity@localhost:5432/apnacity
DB_POOL_MAX=20

# redis
REDIS_URL=redis://localhost:6379

# storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_PUBLIC=apnacity-media
S3_BUCKET_PRIVATE=apnacity-docs
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
CDN_BASE_URL=

# auth
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL=900
REFRESH_SECRET=change-me
OTP_HASH_PEPPER=change-me

# payments
PAYMENT_PROVIDER=cashfree
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=

# notifications
DLT_SMS_PROVIDER=
DLT_SENDER_ID=
DLT_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_KEY=
EMAIL_FROM=
SMTP_URL=

# maps
GEO_PROVIDER=google
GOOGLE_MAPS_KEY=

# misc
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
FEATURE_FLAG_DEFAULTS={}
