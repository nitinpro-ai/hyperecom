# ApnaCity DEV cluster environment (in-cluster service URLs).
# Copy to env-dev.env, fill secrets, then deploy-dev.sh creates the k8s Secret from it.
# NEVER commit the filled copy (values are dev-only but keep the habit).
NODE_ENV=development
API_BASE_URL=http://192.168.2.224:30400
PORT=4000
WEB_BASE_URL=http://192.168.2.224:30080
APP_DOMAIN=apnacity.com
TENANT_RESOLVE_HMAC_SECRET=dev-cluster-hmac-secret-change-me-32ch

DATABASE_URL=postgresql://apnacity:apnacity@postgres.apnacity.svc.cluster.local:5432/apnacity
DB_POOL_MAX=20

REDIS_URL=redis://redis.apnacity.svc.cluster.local:6379

S3_ENDPOINT=http://minio.apnacity.svc.cluster.local:9000
S3_REGION=us-east-1
S3_BUCKET_PUBLIC=apnacity-media
S3_BUCKET_PRIVATE=apnacity-docs
S3_ACCESS_KEY_ID=apnacity
S3_SECRET_ACCESS_KEY=apnacity-secret
CDN_BASE_URL=http://192.168.2.224:30900

JWT_ACCESS_SECRET=dev-cluster-jwt-secret-change-me-32ch!
JWT_ACCESS_TTL=900
REFRESH_SECRET=dev-cluster-refresh-secret-change-me32
OTP_HASH_PEPPER=dev-cluster-otp-pepper-change-me-32ch

PAYMENT_PROVIDER=cashfree
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=

DLT_SMS_PROVIDER=
DLT_SENDER_ID=
DLT_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_KEY=
EMAIL_FROM=no-reply@apnacity.com
SMTP_URL=smtp://localhost:1025

GEO_PROVIDER=google
GOOGLE_MAPS_KEY=

SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
FEATURE_FLAG_DEFAULTS={}
