// ApnaCity database schema (packages/db/prisma/schema.prisma)
// Source of truth: docs/spec/03-data-model.md + COMPLETE-BUILD-GUIDE PART II.
// Extensions (postgis, pg_trgm, ltree) and RLS policies are applied via raw
// SQL migrations in ./migrations — Prisma manages tables, SQL manages extensions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// M26 — audit logs (append-only; DB trigger blocks UPDATE/DELETE — see migration)
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorRole   String?  @map("actor_role")
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id") @db.Uuid
  shopId      String?  @map("shop_id") @db.Uuid
  before      Json?
  after       Json?
  ip          String?
  userAgent   String?  @map("user_agent")
  reason      String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@map("audit_logs")
}

// M27 — outbox events (reliable async module communication, D-015)
model OutboxEvent {
  id             String   @id @default(uuid()) @db.Uuid
  aggregateType  String   @map("aggregate_type")
  aggregateId    String   @map("aggregate_id") @db.Uuid
  eventType      String   @map("event_type") // e.g. "order.placed.v1"
  payload        Json
  status         String   @default("PENDING") // PENDING|DISPATCHED|FAILED|DEAD
  attempts       Int      @default(0)
  nextAttemptAt  DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  dispatchedAt   DateTime? @map("dispatched_at") @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@map("outbox_events")
}


model SystemCheck {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_checks")
}

// M30 — Idempotency (Foundation). Safe retries for mutating POSTs.
// Spec: COMPLETE-BUILD-GUIDE PART II M30. Same key+hash → stored response;
// same key+different request → 409. TTL 24 h (expired rows swept, then reusable).
model IdempotencyKey {
  key            String   @id
  userId         String   @map("user_id") @db.Uuid
  endpoint       String
  requestHash    String   @map("request_hash")
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("idempotency_keys")
}

// M29 — Feature Flags (Foundation). Kill switches + gradual rollout.
// Spec: COMPLETE-BUILD-GUIDE PART II M29. eval(keys, context) with 30 s cache;
// DB unreachable → fall back to default_enabled.
model FeatureFlag {
  key            String   @id
  description    String?
  defaultEnabled Boolean  @default(false) @map("default_enabled")
  rules          Json? // [{ when: {city?/shop?/userId?/percentage?}, enabled: bool }]
  updatedBy      String?  @map("updated_by") @db.Uuid
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("feature_flags")
}

// ---------------------------------------------------------------------------
// M03 — Geography & Serviceability (Step 2). Spec: COMPLETE-BUILD-GUIDE PART II
// M03 + docs/spec/03 §2. Geometry columns are declared Unsupported() so Prisma
// tracks the tables while the geometry types + GiST indexes are created in the
// raw SQL migration (Prisma cannot express PostGIS geometry / gist directly).
// ---------------------------------------------------------------------------

model Country {
  id        String  @id @default(uuid()) @db.Uuid
  isoCode   String  @unique @map("iso_code") @db.VarChar(2)
  name      String
  phoneCode String? @map("phone_code") @db.VarChar(5)

  states State[]

  @@map("countries")
}

model State {
  id        String  @id @default(uuid()) @db.Uuid
  countryId String  @map("country_id") @db.Uuid
  code      String  @db.VarChar(10)
  name      String
  isActive  Boolean @default(true) @map("is_active")

  country Country @relation(fields: [countryId], references: [id])
  cities  City[]

  @@unique([countryId, code])
  @@map("states")
}

model City {
  id       String  @id @default(uuid()) @db.Uuid
  stateId  String  @map("state_id") @db.Uuid
  name     String
  slug     String  @unique
  timezone String  @default("Asia/Kolkata")
  // center geometry(Point,4326) — set via SQL migration
  center   Unsupported("geometry(Point, 4326)")?
  isActive Boolean @default(true) @map("is_active")

  state         State          @relation(fields: [stateId], references: [id])
  localities    Locality[]
  pincodes      Pincode[]
  deliveryZones DeliveryZone[]
  userRoles     UserRole[]
  shops         Shop[]

  @@map("cities")
}

model Locality {
  id     String @id @default(uuid()) @db.Uuid
  cityId String @map("city_id") @db.Uuid
  name   String
  slug   String
  // boundary geometry(MultiPolygon,4326) — set via SQL migration
  boundary Unsupported("geometry(MultiPolygon, 4326)")?

  city City @relation(fields: [cityId], references: [id])

  @@unique([cityId, slug])
  @@map("localities")
}

model Pincode {
  id            String  @id @default(uuid()) @db.Uuid
  cityId        String  @map("city_id") @db.Uuid
  pincode       String  @unique @db.VarChar(6)
  isServiceable Boolean @default(true) @map("is_serviceable")
  // boundary geometry(MultiPolygon,4326) — set via SQL migration
  boundary Unsupported("geometry(MultiPolygon, 4326)")?

  city City @relation(fields: [cityId], references: [id])

  @@map("pincodes")
}

model DeliveryZone {
  id            String  @id @default(uuid()) @db.Uuid
  cityId        String  @map("city_id") @db.Uuid
  name          String
  zoneType      String  @map("zone_type") @db.VarChar(13) // CIRCLE_RADIUS | POLYGON
  radiusM       Int?    @map("radius_m")
  feePaise      BigInt  @map("fee_paise")
  freeAbovePaise BigInt? @map("free_above_paise")
  etaMinMinutes Int     @map("eta_min_minutes")
  etaMaxMinutes Int     @map("eta_max_minutes")
  isActive      Boolean @default(true) @map("is_active")
  // center geometry(Point,4326) + boundary geometry(MultiPolygon,4326) — via SQL migration
  center   Unsupported("geometry(Point, 4326)")?
  boundary Unsupported("geometry(MultiPolygon, 4326)")?

  city City @relation(fields: [cityId], references: [id])

  @@map("delivery_zones")
}

model GeocodeCache {
  cacheKey  String   @id @map("cache_key")
  lat       Float?
  lng       Float?
  formatted String?
  fetchedAt DateTime @default(now()) @map("fetched_at") @db.Timestamptz(3)

  @@map("geocode_cache")
}

// ---------------------------------------------------------------------------
// M02 — Users, Profiles & RBAC (Step 4). Spec: COMPLETE-BUILD-GUIDE PART II M02.
// shop_id columns are plain UUIDs until M05 (shops) adds the FK.
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(uuid()) @db.Uuid
  phone        String    @unique @db.VarChar(15)
  email        String?   @unique
  passwordHash String?   @map("password_hash")
  name         String
  locale       String    @default("EN") @db.VarChar(2) // EN | HI
  status       String    @default("ACTIVE") @db.VarChar(10) // ACTIVE | BLOCKED | DELETED
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  roles           UserRole[]
  customerProfile CustomerProfile?
  addresses       Address[]
  seller          Seller?
  media           Media[]

  @@map("users")
}

model Role {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(20)
  // SUPER_ADMIN | CITY_ADMIN | SELLER_OWNER | SELLER_STAFF | CUSTOMER | DELIVERY_PARTNER | CUSTOMER_SUPPORT

  permissions RolePermission[]
  userRoles   UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(60)
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String  @map("user_id") @db.Uuid
  roleId String  @map("role_id") @db.Uuid
  cityId String? @map("city_id") @db.Uuid
  shopId String? @map("shop_id") @db.Uuid // FK added with M05

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])
  city City? @relation(fields: [cityId], references: [id])

  // Composite PK with COALESCE on nullable city/shop is applied in the SQL
  // migration (Prisma can't express a COALESCE primary key).
  @@id([userId, roleId])
  @@map("user_roles")
}

model CustomerProfile {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  defaultAddressId String?  @map("default_address_id") @db.Uuid
  gender           String?  @db.VarChar(1)
  birthDate        DateTime? @map("birth_date") @db.Date
  marketingConsent Boolean  @default(false) @map("marketing_consent")

  user User @relation(fields: [userId], references: [id])

  @@map("customer_profiles")
}

model Address {
  id         String  @id @default(uuid()) @db.Uuid
  userId     String  @map("user_id") @db.Uuid
  label      String?
  line1      String
  line2      String?
  landmark   String?
  localityId String? @map("locality_id") @db.Uuid
  pincode    String  @db.VarChar(6)
  latitude   Float?
  longitude  Float?
  isDefault  Boolean @default(false) @map("is_default")

  user User @relation(fields: [userId], references: [id])

  @@map("addresses")
}

// ---------------------------------------------------------------------------
// M04 Sellers & KYC · M05 Shops · M06 Shop Domains (Step 5). Spec: PART II
// M04/M05/M06. media_id references are nullable until M10 media (Step 6) exists.
// ---------------------------------------------------------------------------

model Seller {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @map("user_id") @db.Uuid
  legalName      String    @map("legal_name")
  displayName    String    @map("display_name")
  businessType   String    @map("business_type") @db.VarChar(20) // INDIVIDUAL|PROPRIETORSHIP|PARTNERSHIP|LLP|PVT_LTD
  pan            String    @db.VarChar(10)
  gstin          String?   @db.VarChar(15)
  status         String    @default("DRAFT") @db.VarChar(12) // DRAFT|KYC_PENDING|APPROVED|SUSPENDED|REJECTED
  kycSubmittedAt DateTime? @map("kyc_submitted_at") @db.Timestamptz(3)
  approvedAt     DateTime? @map("approved_at") @db.Timestamptz(3)
  approvedBy     String?   @map("approved_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id])
  kycDocuments KycDocument[]
  shops        Shop[]

  @@map("sellers")
}

model BankAccount {
  id          String  @id @default(uuid()) @db.Uuid
  ownerType   String  @map("owner_type") @db.VarChar(15) // SELLER|DELIVERY_PARTNER
  ownerId     String  @map("owner_id") @db.Uuid
  holderName  String  @map("holder_name")
  accountNoEnc String @map("account_no_enc") // encrypted at rest
  ifsc        String  @db.VarChar(11)
  verified    Boolean @default(false)
  isPrimary   Boolean @default(true) @map("is_primary")

  @@index([ownerType, ownerId])
  @@map("bank_accounts")
}

model KycDocument {
  id         String  @id @default(uuid()) @db.Uuid
  sellerId   String  @map("seller_id") @db.Uuid
  docType    String  @map("doc_type") @db.VarChar(20)
  mediaId    String? @map("media_id") @db.Uuid // FK to media added with M10
  status     String  @default("PENDING") @db.VarChar(10) // PENDING|VERIFIED|REJECTED
  verifiedBy String? @map("verified_by") @db.Uuid
  note       String?

  seller Seller @relation(fields: [sellerId], references: [id])

  @@map("kyc_documents")
}

model Shop {
  id           String   @id @default(uuid()) @db.Uuid // tenant root
  sellerId     String   @map("seller_id") @db.Uuid
  cityId       String   @map("city_id") @db.Uuid
  name         String
  slug         String   @unique
  logoMediaId  String?  @map("logo_media_id") @db.Uuid
  bannerMediaId String? @map("banner_media_id") @db.Uuid
  description  String?
  categoryIds  String[] @default([]) @map("category_ids") @db.Uuid
  status       String   @default("PENDING") @db.VarChar(9) // PENDING|ACTIVE|SUSPENDED|CLOSED
  ratingAvg    Decimal  @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount  Int      @default(0) @map("rating_count")
  openedAt     DateTime? @map("opened_at") @db.Timestamptz(3)
  closedAt     DateTime? @map("closed_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  seller   Seller        @relation(fields: [sellerId], references: [id])
  city     City          @relation(fields: [cityId], references: [id])
  domain   ShopDomain?
  settings ShopSettings?
  listings SellerListing[]

  @@map("shops")
}

model ShopDomain {
  id         String    @id @default(uuid()) @db.Uuid
  shopId     String    @unique @map("shop_id") @db.Uuid
  host       String    @unique
  hostType   String    @default("SUBDOMAIN") @map("host_type") @db.VarChar(10)
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(3)
  sslStatus  String    @default("PENDING") @map("ssl_status") @db.VarChar(8) // PENDING|ACTIVE|FAILED

  shop Shop @relation(fields: [shopId], references: [id])

  @@map("shop_domains")
}

model ShopSettings {
  id                     String  @id @default(uuid()) @db.Uuid
  shopId                 String  @unique @map("shop_id") @db.Uuid
  deliveryMode           String  @default("BOTH") @map("delivery_mode") @db.VarChar(9) // SELF|PLATFORM|BOTH
  pickupAddressId        String? @map("pickup_address_id") @db.Uuid
  openingHours           Json?   @map("opening_hours")
  returnPolicyText       String? @map("return_policy_text")
  minOrderPaise          BigInt  @default(0) @map("min_order_paise")
  commissionRateOverride Decimal? @map("commission_rate_override") @db.Decimal(5, 2)
  locale                 String  @default("EN") @db.VarChar(2)
  theme                  Json?

  shop Shop @relation(fields: [shopId], references: [id])

  @@map("shop_settings")
}

// ---------------------------------------------------------------------------
// M10 — Media (Step 6). Signed uploads, derivatives, scanning, per-shop quota.
// Spec: PART II M10. Storage via StoragePort (dev: local; prod: MinIO/S3).
// ---------------------------------------------------------------------------

model Media {
  id          String  @id @default(uuid()) @db.Uuid
  ownerUserId String  @map("owner_user_id") @db.Uuid
  shopId      String? @map("shop_id") @db.Uuid
  kind        String  @db.VarChar(14) // PRODUCT_IMAGE|LOGO|BANNER|POD|DOCUMENT|RETURN_PHOTO
  storageKey  String  @map("storage_key")
  mime        String  @db.VarChar(30)
  width       Int?
  height      Int?
  sizeBytes   Int     @map("size_bytes")
  variants    Json? // { "256": key, "512": key, "1024": key }
  scanStatus  String  @default("PENDING") @map("scan_status") @db.VarChar(9) // PENDING|CLEAN|REJECTED
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  owner User @relation(fields: [ownerUserId], references: [id])

  @@index([shopId])
  @@index([ownerUserId])
  @@map("media")
}

// ---------------------------------------------------------------------------
// M07 Catalog (categories/brands/products/variants/media/match_groups) +
// M08 Listings (seller_listings/listing_variants/price_history). Step 7.
// Spec: PART II M07/M08. category.path is ltree (set via SQL migration); FTS +
// trigram indexes added in SQL. listing_variants carries shop_id for tenant RLS
// + the UNIQUE(shop_id, seller_sku) the spec requires.
// ---------------------------------------------------------------------------

model Category {
  id               String   @id @default(uuid()) @db.Uuid
  parentId         String?  @map("parent_id") @db.Uuid
  name             String
  slug             String   @unique
  // path ltree — maintained via SQL (Prisma has no ltree type)
  pathText         String   @map("path_text") // mirror of ltree path as text
  attributeSchema  Json?    @map("attribute_schema")
  iconMediaId      String?  @map("icon_media_id") @db.Uuid
  sortOrder        Int      @default(0) @map("sort_order")
  isActive         Boolean  @default(true) @map("is_active")
  requiresApproval Boolean  @default(false) @map("requires_approval")
  returnWindowDays Int      @default(7) @map("return_window_days")
  isNonReturnable  Boolean  @default(false) @map("is_non_returnable")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("categories")
}

model Brand {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  slug        String  @unique
  logoMediaId String? @map("logo_media_id") @db.Uuid
  isActive    Boolean @default(true) @map("is_active")

  products Product[]

  @@map("brands")
}

model Product {
  id                      String   @id @default(uuid()) @db.Uuid
  categoryId              String   @map("category_id") @db.Uuid
  brandId                 String?  @map("brand_id") @db.Uuid
  name                    String
  slug                    String   @unique
  description             String?
  gtin                    String?  @unique @db.VarChar(14)
  attributes              Json?
  status                  String   @default("DRAFT") @db.VarChar(15) // DRAFT|PENDING_REVIEW|ACTIVE|INACTIVE
  matchGroupId            String?  @map("match_group_id") @db.Uuid
  createdBy               String?  @map("created_by") @db.Uuid
  categorySchemaSnapshot  Json?    @map("category_schema_snapshot")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  category Category         @relation(fields: [categoryId], references: [id])
  brand    Brand?           @relation(fields: [brandId], references: [id])
  variants ProductVariant[]
  listings SellerListing[]

  @@map("products")
}

model ProductVariant {
  id           String  @id @default(uuid()) @db.Uuid
  productId    String  @map("product_id") @db.Uuid
  sku          String? @unique
  attributes   Json // {"size":"M","color":"Blue"}
  weightGrams  Int?    @map("weight_grams")
  dimensionsMm Json?   @map("dimensions_mm")
  barcode      String? @db.VarChar(20)
  isActive     Boolean @default(true) @map("is_active")

  product         Product          @relation(fields: [productId], references: [id])
  listingVariants ListingVariant[]

  @@map("product_variants")
}

model ProductMedia {
  id        String  @id @default(uuid()) @db.Uuid
  productId String? @map("product_id") @db.Uuid
  variantId String? @map("variant_id") @db.Uuid
  shopId    String? @map("shop_id") @db.Uuid
  mediaId   String  @map("media_id") @db.Uuid
  sortOrder Int     @default(0) @map("sort_order")
  isPrimary Boolean @default(false) @map("is_primary")

  @@index([productId])
  @@map("product_media")
}

model MatchGroup {
  id                 String   @id @default(uuid()) @db.Uuid
  status             String   @default("OPEN") @db.VarChar(9) // OPEN|MERGED|DISMISSED
  canonicalProductId String?  @map("canonical_product_id") @db.Uuid
  similarity         Decimal? @db.Decimal(4, 3)
  resolvedBy         String?  @map("resolved_by") @db.Uuid

  @@map("match_groups")
}

model SellerListing {
  id             String    @id @default(uuid()) @db.Uuid // tenant
  shopId         String    @map("shop_id") @db.Uuid
  productId      String    @map("product_id") @db.Uuid
  titleOverride  String?   @map("title_override")
  status         String    @default("DRAFT") @db.VarChar(13) // DRAFT|PAUSED|ACTIVE|OUT_OF_STOCK|REJECTED
  listedAt       DateTime? @map("listed_at") @db.Timestamptz(3)
  deactivatedAt  DateTime? @map("deactivated_at") @db.Timestamptz(3)

  product  Product          @relation(fields: [productId], references: [id])
  shop     Shop             @relation(fields: [shopId], references: [id])
  variants ListingVariant[]

  @@unique([shopId, productId])
  @@index([shopId, status])
  @@index([productId, status])
  @@map("seller_listings")
}

model ListingVariant {
  id          String  @id @default(uuid()) @db.Uuid // tenant
  listingId   String  @map("listing_id") @db.Uuid
  shopId      String  @map("shop_id") @db.Uuid // carried for tenant RLS + unique seller_sku
  variantId   String  @map("variant_id") @db.Uuid
  sellerSku   String  @map("seller_sku")
  mrpPaise    BigInt  @map("mrp_paise")
  pricePaise  BigInt  @map("price_paise")
  taxRateBp   Int     @default(0) @map("tax_rate_bp")
  stockTracked Boolean @default(true) @map("stock_tracked")
  isActive    Boolean @default(true) @map("is_active")

  listing        SellerListing  @relation(fields: [listingId], references: [id])
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  priceHistory   PriceHistory[]

  @@unique([listingId, variantId])
  @@unique([shopId, sellerSku])
  @@map("listing_variants")
}

model PriceHistory {
  id               String   @id @default(uuid()) @db.Uuid
  listingVariantId String   @map("listing_variant_id") @db.Uuid
  pricePaise       BigInt   @map("price_paise")
  changedBy        String?  @map("changed_by") @db.Uuid
  reason           String?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  listingVariant ListingVariant @relation(fields: [listingVariantId], references: [id])

  @@map("price_history")
}

// ---------------------------------------------------------------------------
// M09 — Inventory (Step 8). Single stock authority; atomic reservations prevent
// oversell. Spec: PART II M09. CHECK(on_hand >= reserved) + the conditional
// UPDATE are added/used via SQL. inventory_locations + stock are tenant tables.
// ---------------------------------------------------------------------------

model InventoryLocation {
  id        String  @id @default(uuid()) @db.Uuid // tenant
  shopId    String  @map("shop_id") @db.Uuid
  name      String  @default("Shop Floor")
  addressId String? @map("address_id") @db.Uuid
  isDefault Boolean @default(true) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")

  stock Stock[]

  @@map("inventory_locations")
}

model Stock {
  id               String @id @default(uuid()) @db.Uuid
  locationId       String @map("location_id") @db.Uuid
  listingVariantId String @map("listing_variant_id") @db.Uuid
  quantityOnHand   Int    @default(0) @map("quantity_on_hand")
  quantityReserved Int    @default(0) @map("quantity_reserved")
  reorderLevel     Int?   @default(5) @map("reorder_level")

  location     InventoryLocation  @relation(fields: [locationId], references: [id])
  movements    StockMovement[]
  reservations StockReservation[]

  @@unique([locationId, listingVariantId])
  @@index([listingVariantId])
  @@map("stock")
}

model StockMovement {
  id            String   @id @default(uuid()) @db.Uuid // append-only
  stockId       String   @map("stock_id") @db.Uuid
  deltaOnHand   Int      @map("delta_on_hand")
  deltaReserved Int      @map("delta_reserved")
  reason        String   @db.VarChar(15) // ORDER_RESERVE|ORDER_RELEASE|ORDER_SALE|RETURN|MANUAL_ADJUST|IMPORT|CORRECTION
  referenceType String?  @map("reference_type")
  referenceId   String?  @map("reference_id") @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  stock Stock @relation(fields: [stockId], references: [id])

  @@index([stockId])
  @@map("stock_movements")
}

model StockReservation {
  id          String   @id @default(uuid()) @db.Uuid
  stockId     String   @map("stock_id") @db.Uuid
  orderItemId String   @map("order_item_id") @db.Uuid
  quantity    Int
  status      String   @default("ACTIVE") @db.VarChar(9) // ACTIVE|RELEASED|CONSUMED
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  stock Stock @relation(fields: [stockId], references: [id])

  @@index([status, expiresAt])
  @@map("stock_reservations")
}
