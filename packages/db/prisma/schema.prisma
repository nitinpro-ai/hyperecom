  event         String   @db.VarChar(24)
  fromStatus    String?  @map("from_status")
  toStatus      String?  @map("to_status")
  actorType     String   @map("actor_type") @db.VarChar(8) // CUSTOMER|SELLER|RIDER|ADMIN|SYSTEM
  actorId       String?  @map("actor_id") @db.Uuid
  payload       Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([orderId])
  @@map("order_events")
}

model Payment {
  id              String    @id @default(uuid()) @db.Uuid
  orderId         String    @map("order_id") @db.Uuid
  provider        String    @db.VarChar(8) // CASHFREE|RAZORPAY|COD
  providerOrderRef String?  @map("provider_order_ref")
  amountPaise     BigInt    @map("amount_paise")
  currency        String    @default("INR") @db.Char(3)
  method          String?   @db.VarChar(10) // UPI|CARD|NETBANKING|WALLET|COD
  status          String    @default("CREATED") @db.VarChar(16) // CREATED|AUTHORIZED|CAPTURED|FAILED|REFUNDED|PARTIALLY_REFUNDED
  capturedAt      DateTime? @map("captured_at") @db.Timestamptz(3)
  idempotencyKey  String?   @unique @map("idempotency_key")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  order        Order                @relation(fields: [orderId], references: [id])
  transactions PaymentTransaction[]
  refunds      Refund[]

  @@index([orderId])
  @@map("payments")
}

model PaymentTransaction {
  id               String  @id @default(uuid()) @db.Uuid
  paymentId        String  @map("payment_id") @db.Uuid
  providerTxnRef   String? @map("provider_txn_ref")
  type             String? @db.VarChar(7) // CREATE|CAPTURE|REFUND|STATUS
  status           String?
