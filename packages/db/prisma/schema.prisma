  mediaIds        String[]  @default([]) @map("media_ids") @db.Uuid
  status          String    @default("REQUESTED") @db.VarChar(17) // REQUESTED|APPROVED|REJECTED|PICKUP_SCHEDULED|PICKED_UP|RECEIVED|INSPECTION_PASSED|INSPECTION_FAILED|REFUND_INITIATED|COMPLETED|CANCELLED
  refundMethod    String?   @map("refund_method") @db.VarChar(6) // ORIGINAL|UPI
