  sellerOrderId   String    @map("seller_order_id") @db.Uuid
  orderItemId     String    @map("order_item_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  reason          String    @db.VarChar(15) // DAMAGED|WRONG_ITEM|NOT_AS_DESCRIBED|SIZE_ISSUE|CHANGED_MIND|LATE_DELIVERY|OTHER
