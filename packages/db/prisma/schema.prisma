// ---------------------------------------------------------------------------
// M16 Finance — double-entry ledger, commission, settlements (Step 15).
// ledger_entries: SUM(debit)=SUM(credit) per transaction_id + append-only,
// enforced by DB triggers (raw SQL migration). Money = integer paise.
// ---------------------------------------------------------------------------

model LedgerAccount {
  id           String @id @default(uuid()) @db.Uuid
  ownerType    String @map("owner_type") @db.VarChar(16) // PLATFORM|SELLER|DELIVERY_PARTNER|CUSTOMER
  ownerId      String @map("owner_id") @db.Uuid
  accountType  String @map("account_type") @db.VarChar(20) // RECEIVABLE|PAYABLE|COMMISSION_INCOME|DELIVERY_INCOME|GATEWAY_FEE|TAX_COLLECTED|COD_HOLDING|REFUND_CLAIM
  balancePaise BigInt @default(0) @map("balance_paise")

  entries LedgerEntry[]

  @@unique([ownerType, ownerId, accountType])
  @@map("ledger_accounts")
}

model LedgerEntry {
  id              String  @id @default(uuid()) @db.Uuid
  transactionId   String  @map("transaction_id") @db.Uuid // groups both sides
  ledgerAccountId String  @map("ledger_account_id") @db.Uuid
  debitPaise      BigInt  @default(0) @map("debit_paise")
  creditPaise     BigInt  @default(0) @map("credit_paise")
  sourceType      String? @map("source_type")
  sourceId        String? @map("source_id") @db.Uuid
  memo            String?
  settlementId    String? @map("settlement_id") @db.Uuid
  createdBy       String? @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  account LedgerAccount @relation(fields: [ledgerAccountId], references: [id])

  @@index([transactionId])
  @@index([ledgerAccountId])
  @@map("ledger_entries")
}

model Settlement {
  id               String    @id @default(uuid()) @db.Uuid
  sellerId         String    @map("seller_id") @db.Uuid
  periodStart      DateTime? @map("period_start") @db.Date
  periodEnd        DateTime? @map("period_end") @db.Date
  grossSalesPaise  BigInt?   @map("gross_sales_paise")
  commissionPaise  BigInt?   @map("commission_paise")
  deliveryPaise    BigInt?   @map("delivery_paise")
  refundsPaise     BigInt?   @map("refunds_paise")
  tcsPaise         BigInt?   @map("tcs_paise")
  adjustmentsPaise BigInt?   @map("adjustments_paise")
  netPaise         BigInt?   @map("net_paise")
  status           String    @default("PENDING") @db.VarChar(10) // PENDING|PROCESSING|PAID|FAILED
  providerPayoutRef String?  @map("provider_payout_ref")
  utr              String?
  paidAt           DateTime? @map("paid_at") @db.Timestamptz(3)
  statementNo      String?   @unique @map("statement_no")
  approvedBy       String[]  @default([]) @map("approved_by") @db.Uuid // two-person approval
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  items SettlementItem[]

  @@index([sellerId, status])
  @@map("settlements")
}

model SettlementItem {
  id            String @id @default(uuid()) @db.Uuid
  settlementId  String @map("settlement_id") @db.Uuid
  sellerOrderId String @map("seller_order_id") @db.Uuid
  amountPaise   BigInt @map("amount_paise")
  breakdown     Json?

  settlement Settlement @relation(fields: [settlementId], references: [id])

  @@map("settlement_items")
}

model Commission {
  id         String    @id @default(uuid()) @db.Uuid
  cityId     String?   @map("city_id") @db.Uuid
  categoryId String?   @map("category_id") @db.Uuid
  shopId     String?   @map("shop_id") @db.Uuid // shop = seller override
  rateBp     Int       @map("rate_bp")
  validFrom  DateTime? @map("valid_from") @db.Timestamptz(3)
  validTo    DateTime? @map("valid_to") @db.Timestamptz(3)

  @@map("commissions")
}

// ---------------------------------------------------------------------------
// M31 Invoicing (Step 15) — GST tax invoice per child order, credit note per
// refund. Per-seller GST series + sequential numbering; e-invoice IRN hooks.
// ---------------------------------------------------------------------------

model Invoice {
  id            String   @id @default(uuid()) @db.Uuid
  sellerOrderId String   @unique @map("seller_order_id") @db.Uuid
  sellerId      String   @map("seller_id") @db.Uuid
  series        String   // per-seller GST series, e.g. "AP2026"
  seqNo         Int      @map("seq_no")
  invoiceNo     String   @unique @map("invoice_no") // series + seqNo rendered
  taxableValuePaise BigInt @map("taxable_value_paise")
  taxTotalPaise BigInt   @map("tax_total_paise")
  grandTotalPaise BigInt @map("grand_total_paise")
  placeOfSupply String?  @map("place_of_supply") // state code
  irn           String?  // e-invoice reference number (hook; set when IRP integrated)
  qrPayload     String?  @map("qr_payload")
  pdfMediaId    String?  @map("pdf_media_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  creditNotes CreditNote[]

  @@unique([series, seqNo])
  @@index([sellerId])
  @@map("invoices")
}

model CreditNote {
  id            String   @id @default(uuid()) @db.Uuid
  invoiceId     String   @map("invoice_id") @db.Uuid
  refundId      String   @unique @map("refund_id") @db.Uuid
  series        String
  seqNo         Int      @map("seq_no")
  creditNoteNo  String   @unique @map("credit_note_no")
  amountPaise   BigInt   @map("amount_paise")
  reason        String?
  irn           String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@unique([series, seqNo])
  @@map("credit_notes")
}

// ---------------------------------------------------------------------------
// M11 Search & Discovery (Step 10). FTS + pg_trgm + PostGIS over ACTIVE
// listings (indexes from M07 migrations). Only synonyms are a table; results
// are projected from live listing/product/shop rows. Spec: PART II M11.
// ---------------------------------------------------------------------------

model SearchSynonym {
  id       String   @id @default(uuid()) @db.Uuid
  term     String
  synonyms String[] @default([])
  locale   String   @default("EN") @db.VarChar(2)

  @@unique([term, locale])
  @@map("search_synonyms")
}

// ---------------------------------------------------------------------------
// M25 Analytics (Step 16). Event stream + daily rollups. Tenant-scoped reads
// (seller sees own shop only). No raw PII in the event payload. Spec: PART II M25.
// ---------------------------------------------------------------------------

model AnalyticsEvent {
  id        String   @id @default(uuid()) @db.Uuid
  eventType String   @map("event_type") @db.VarChar(20) // SEARCH|PRODUCT_VIEW|ADD_TO_CART|CHECKOUT_START|ORDER_PLACED|...
  cityId    String?  @map("city_id") @db.Uuid
  shopId    String?  @map("shop_id") @db.Uuid
  // anonymised actor key (hashed session/user) — never raw PII
  actorKey  String?  @map("actor_key")
  payload   Json?    // non-PII dimensions only (productId, value_paise, query length…)
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([eventType, occurredAt])
  @@index([shopId, occurredAt])
  @@index([cityId, occurredAt])
  @@map("analytics_events")
}

model AnalyticsRollup {
  id        String   @id @default(uuid()) @db.Uuid
  day       DateTime @db.Date
  scope     String   @db.VarChar(8) // PLATFORM|CITY|SHOP
  scopeId   String?  @map("scope_id") @db.Uuid // cityId or shopId; null for PLATFORM
  eventType String   @map("event_type") @db.VarChar(20)
  count     Int      @default(0)
  valuePaise BigInt  @default(0) @map("value_paise") // summed value where applicable (GMV)

  @@unique([day, scope, scopeId, eventType])
  @@index([scope, scopeId, day])
  @@map("analytics_rollups")
}

// ---------------------------------------------------------------------------
// M28 Webhooks (outbound). Seller/system subscriptions to events, HMAC-signed
// payloads, retries 1m/5m/30m/2h/6h → DEAD. Spec: PART II M28 / 04 §5.
// ---------------------------------------------------------------------------

model WebhookSubscription {
  id         String   @id @default(uuid()) @db.Uuid
  ownerType  String   @map("owner_type") @db.VarChar(8) // SELLER|SYSTEM
  ownerId    String?  @map("owner_id") @db.Uuid
  url        String
  secret     String   // HMAC signing secret (per subscription)
  eventTypes String[] @default([]) @map("event_types") // e.g. ["order.child.accepted.v1","settlement.paid.v1"]
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  deliveries WebhookDelivery[]

  @@index([ownerType, ownerId])
  @@map("webhook_subscriptions")
}

model WebhookDelivery {
  id             String    @id @default(uuid()) @db.Uuid
  subscriptionId String    @map("subscription_id") @db.Uuid
  eventType      String    @map("event_type")
  payload        Json
  status         String    @default("PENDING") @db.VarChar(9) // PENDING|DELIVERED|FAILED|DEAD
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lastStatusCode Int?      @map("last_status_code")
  lastError      String?   @map("last_error")
  deliveredAt    DateTime? @map("delivered_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id])

  @@index([status, nextAttemptAt])
  @@map("webhook_deliveries")
}

// ---------------------------------------------------------------------------
// M21 Reviews (Phase 4). Verified-purchase reviews (one per order_item) +
// exact aggregate recompute on approve. Spec: PART II M21.
// ---------------------------------------------------------------------------

model Review {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  sellerOrderId    String   @map("seller_order_id") @db.Uuid
  orderItemId      String   @unique @map("order_item_id") @db.Uuid // one review per item
  productId        String   @map("product_id") @db.Uuid
  shopId           String   @map("shop_id") @db.Uuid
  rating           Int      // 1..5 (CHECK in SQL)
  title            String?
  body             String?
  mediaIds         String[] @default([]) @map("media_ids") @db.Uuid
  status           String   @default("PENDING") @db.VarChar(9) // PENDING|APPROVED|REJECTED
  moderationReason String?  @map("moderation_reason")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([productId, status])
  @@index([shopId, status])
  @@map("reviews")
}

// ---------------------------------------------------------------------------
// M32 Content (Step 18). CMS: city landing pages, banners, FAQ. Admin CRUD +
// public read. Spec: PART II M32.
// ---------------------------------------------------------------------------

model Page {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique // e.g. "bijnor" (city landing) or "about"
  cityId      String?  @map("city_id") @db.Uuid // null = global page
  title       String
  body        String   // markdown/HTML content
  metaTitle   String?  @map("meta_title")
  metaDesc    String?  @map("meta_desc")
  isPublished Boolean  @default(false) @map("is_published")
  updatedBy   String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([cityId, isPublished])
  @@map("pages")
}

model Banner {
  id          String    @id @default(uuid()) @db.Uuid
  cityId      String?   @map("city_id") @db.Uuid // null = all cities
  title       String
  imageMediaId String?  @map("image_media_id") @db.Uuid
  linkUrl     String?   @map("link_url")
  sortOrder   Int       @default(0) @map("sort_order")
  activeFrom  DateTime? @map("active_from") @db.Timestamptz(3)
  activeTo    DateTime? @map("active_to") @db.Timestamptz(3)
  isActive    Boolean   @default(true) @map("is_active")

  @@index([cityId, isActive])
  @@map("banners")
}

model Faq {
  id        String  @id @default(uuid()) @db.Uuid
  category  String  @default("GENERAL")
  question  String
  answer    String
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  @@index([category, isActive])
  @@map("faqs")
}
